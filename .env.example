# ============================================================
# Forge Labs AI Voice Agent — Environment Variables
# Copy this file to .env and fill in your keys
# ============================================================

# --- LiveKit ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Deepgram (STT) ---
DEEPGRAM_API_KEY=your_deepgram_api_key

# --- ElevenLabs (TTS — Voice Clone) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# --- Groq (LLM - Ultra-fast inference) ---
GROQ_API_KEY=your_groq_api_key

# --- Optional: Google Gemini (LLM) ---
GEMINI_API_KEY=your_gemini_api_key

# --- Optional: Webhook for lead capture (n8n / CRM) ---
# LEAD_WEBHOOK_URL=https://your-n8n-instance.com/webhook/forge-labs-leads
